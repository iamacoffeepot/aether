# Host-local environment for the Bloomery coordinator's systemd user unit
# (scripts/bloomery.service). Copy it to ~/.config/bloomery/bloomery.env and
# edit every path below — the unit reads no other host-specific source, and the
# copy you edit is never committed.
#
# This is systemd's EnvironmentFile syntax: plain KEY=VALUE, one per line, `#`
# comments. No shell runs over it, so `export`, `$HOME`, command substitution,
# and globs are all literal text. Write absolute paths out in full.
#
# No credential belongs here. The unit mints GITHUB_TOKEN from `gh auth token`
# at each start; the comment beside its ExecStart line says why.

# Where the coordinator runs. Its working directory, so the approval policy
# (AETHER_APPROVAL_POLICY_FILE, `approval-policy.yml` by default) resolves
# against it: point this at the repository checkout's root.
BLOOMERY_HOME=/home/YOU/aether

# The binary the unit executes. Build it with
# `cargo build --release -p aether-chassis-bloomery --bin bloomery`; a fresh
# build takes effect at the next `systemctl --user restart bloomery`.
BLOOMERY_BIN=/home/YOU/aether/target/release/bloomery

# The repository the coordinator mirrors projections into and lands candidates
# against. Both halves are required; the boot log names either one when it is
# missing.
AETHER_GITHUB_OWNER=iamacoffeepot
AETHER_GITHUB_REPO=aether

# The durable journal. Leaving it at the compiled `:memory:` default would drop
# every bloom the moment the unit restarts, which is the one setting that turns
# a supervised coordinator back into a disposable one.
AETHER_STORE_PATH=/home/YOU/bloomery/bloomery.db

# The artifact content store's root — candidates, evidence, study records.
AETHER_ARTIFACTS_ROOT=/home/YOU/bloomery/artifacts

# Where a local lane checks its order's subject out, one worktree per nonce.
# Absolute, so the checkout resolves wherever the coordinator's cwd points.
AETHER_GITHUB_LOCAL_WORKTREE_BASE=/home/YOU/bloomery/local-worktrees

# The volume a model lane's child builds its throwaway target directories on.
# Give it tens of gigabytes per concurrent lane, and prefer a disk other than
# the root filesystem: a full root kills every later lane before it compiles a
# line. The unit's ExecStartPre reaps what a dead run left behind here, so this
# root belongs to one coordinator.
AETHER_LANE_SCRATCH=/mnt/scratch/bloomery-lanes

# The build cache lanes inherit from the coordinator. A model lane's child
# builds under AETHER_LANE_SCRATCH instead, since its subject is a different
# tree; the mechanical lanes share this one and skip a cold compile each.
CARGO_TARGET_DIR=/home/YOU/bloomery/lane-target

# How often the reactors poll the store outbox, in seconds.
AETHER_GITHUB_POLL_INTERVAL_SECS=5

# The REST control ingress, bound on localhost.
AETHER_HTTP_PORT=8910

# The user manager's PATH carries neither rustup's shims nor a ~/.local/bin
# install of `gh`, and a lane's program is `cargo xtask transform`, so spell out
# a PATH that reaches cargo, git, and gh.
PATH=/home/YOU/.cargo/bin:/usr/local/bin:/usr/bin:/bin

# Knobs worth knowing about, shown at their compiled defaults:
# AETHER_RPC_PORT=8909
# AETHER_BLOOMERY_MAX_CONCURRENT_LANES=3
# AETHER_APPROVAL_POLICY_FILE=approval-policy.yml
# AETHER_BLOOMERY_OPERATOR_NAME=
# AETHER_BLOOMERY_OPERATOR_EMAIL=
