# Host-local environment for the hub chassis's systemd user unit
# (scripts/aether-hub.service). Copy it to ~/.config/aether/hub.env and edit
# every path below — the unit reads no other host-specific source, and the copy
# you edit is never committed.
#
# This is systemd's EnvironmentFile syntax: plain KEY=VALUE, one per line, `#`
# comments. No shell runs over it, so `export`, `$HOME`, command substitution,
# and globs are all literal text. Write absolute paths out in full.
#
# No credential belongs here, and the hub asks for none: it reads no token, no
# webhook, and no repository credential of any kind.
#
# Every AETHER_* key below is claimed by a config knob the hub actually
# resolves. That matters more here than it does for the coordinator: the hub
# sweeps its own environment at boot and warns on any AETHER_* variable no
# registered knob claims, so a typo or a stale export shows up as a warning
# line in the journal rather than being silently ignored. `aether-hub
# --print-config` prints the source-resolved value of every knob, and
# `aether-hub --describe` prints the binary's linked caps.

# The binary the unit executes. Build it with
# `cargo build --release -p aether-chassis-hub --bin aether-hub`; a fresh build
# takes effect at the next `systemctl --user restart aether-hub`. No AETHER_
# prefix — this is the unit's own wrapper variable, not a config knob, and the
# hub would warn about an unclaimed AETHER_* name.
HUB_BIN=/path/to/aether/target/release/aether-hub

# The port the hub binds its `aether.rpc.server` on — the address aether-mcp
# and the rest of the fleet dial. Unset would leave the RPC server composed but
# unbound for any other chassis; the hub always binds, falling back to its
# DEFAULT_RPC_PORT (8901, crates/aether-chassis-hub/src/lib.rs) when this is
# unset. Read at crates/aether-rpc/src/server/config.rs:33.
AETHER_RPC_PORT=8901

# Parent directory for the engines cap's per-engine spawn and handle-store
# dirs. Each spawn materializes the resolved substrate binary to
# <root>/<engine-id>/substrate and nothing removes it when the engine dies, so
# set this explicitly: the unit's ExecStartPre reaps this root at every start
# and refuses to guess one, and the root belongs to exactly one hub. Unset in
# the code falls back to the platform data dir, then the system temp dir. Read
# at crates/aether-fleet/src/server/config.rs:168, resolved by
# `resolve_fleet_store_root` (crates/aether-fleet/src/server/fleet.rs:51).
AETHER_FLEET_STORE_ROOT=/path/to/aether-hub/engines

# The content-addressed store of uploaded binaries and components (ADR-0115 /
# ADR-0116). Point it somewhere that outlives a restart and keep it outside
# AETHER_FLEET_STORE_ROOT, which the unit reaps. Unset uses the platform data
# dir. Read at crates/aether-fleet/src/server/config.rs:156.
AETHER_BINARY_STORE_DIR=/path/to/aether-hub/binaries

# Chassis binaries ingested into that store at startup, comma-separated
# absolute paths, each named by its file stem. Without at least one, a
# `spawn_substrate` with no selector — or with a `name` selector — has nothing
# to resolve in a freshly started hub until something uploads a binary. Ingest
# is content-addressed and idempotent. Read at
# crates/aether-fleet/src/server/config.rs:183.
AETHER_BINARY_BOOTSTRAP=/path/to/aether/target/release/aether-headless,/path/to/aether/target/release/aether-desktop

# The tracing directive the hub installs over its own log output. `info` is the
# compiled default; `EnvFilter` syntax. Read at
# crates/aether-chassis/src/boot.rs:538.
AETHER_LOG_FILTER=info

# The user manager's PATH is not a login shell's. A forked substrate inherits
# PATH from the hub (it is on the engines cap's child-environment allowlist,
# crates/aether-fleet/src/child_env.rs), so spell out one that reaches whatever
# a substrate's own subprocesses need.
PATH=/usr/local/bin:/usr/bin:/bin

# Engine liveness, shown at their compiled defaults
# (crates/aether-fleet/src/server/config.rs). A missed-ping eviction takes
# miss_limit x interval_secs; 0 in either disables the heartbeat entirely, so a
# wedged engine is then only noticed when its connection closes.
# AETHER_HUB_HEARTBEAT_INTERVAL_SECS=5      # :87
# AETHER_HUB_HEARTBEAT_MISS_LIMIT=3         # :93

# Spawn patience and retry, at their compiled defaults
# (crates/aether-fleet/src/server/config.rs). The connect budget is how long a
# freshly forked substrate may take to dial back before the spawn is called
# failed; 0 is the wait-forever sentinel. The attempt count re-forks on a fresh
# port, which is what escapes a port lost in the allocation race.
# AETHER_HUB_PROXY_CONNECT_BUDGET_SECS=30   # :101
# AETHER_HUB_PROXY_SPAWN_ATTEMPTS=3         # :113

# Automatic engine restart, off by default
# (crates/aether-fleet/src/server/config.rs). With it on, a crashed or evicted
# engine is re-forked from the recipe it was spawned with, under a burst limit
# counted over a rolling window. A deliberate `terminate_substrate` is never
# restarted whatever these say.
# AETHER_HUB_RESTART_ON_CRASH=false         # :123
# AETHER_HUB_RESTART_BACKOFF_MILLIS=500     # :131
# AETHER_HUB_RESTART_BURST_LIMIT=5          # :140
# AETHER_HUB_RESTART_BURST_WINDOW_SECS=300  # :147

# On-disk byte budget for the binary store; LRU eviction over unpinned,
# unnamed entries holds it. The compiled default is 16 GiB. Read at
# crates/aether-fleet/src/server/config.rs:174.
# AETHER_HUB_BINARY_DISK_BUDGET_BYTES=17179869184

# Per-actor ring capacities for the actors the hub's own registry hosts
# (ADR-0081; crates/aether-chassis/src/boot.rs). The log ring is drop-oldest;
# the trace ring grows from its floor toward its ceiling only to protect chains
# still in flight.
# AETHER_ACTOR_LOG_RING_SIZE=1024           # :135
# AETHER_ACTOR_TRACE_RING_SIZE=4096         # :143
# AETHER_ACTOR_TRACE_RING_MAX_SIZE=65536    # :150

# ADR-0165 serialized-queue bounds for those same actors
# (crates/aether-chassis/src/boot.rs).
# AETHER_REGISTRY_OWNER_QUEUE_CAPACITY=4096 # :206
# AETHER_REGISTRY_RELAY_QUEUE_CAPACITY=4096 # :214

# Scheduler hot-path tuning (crates/aether-chassis/src/boot.rs). Defaults are
# tuned; reach for these only with a measurement in hand.
# AETHER_SPIN_WINDOW_USEC=50                # :262
# AETHER_LOCAL_STICKY_MAX=256               # :268
# AETHER_LOCAL_TIME_BUDGET_US=                # :275 (unset)
# AETHER_PEER_STEAL=false                   # :280
# AETHER_LOCAL_CHAIN_BACKSTOP=64            # :286
# AETHER_HANDOFF_COST_NS=                     # :293 (unset)
# AETHER_BLOB_RECRUIT_MIN=9                 # :299
# AETHER_BLOB_RECRUIT_MAX=32                # :305
# AETHER_WAKE_COST_NANOS=                     # :312 (unset)

# The hub's own teardown patience, in seconds; 0 means no cap. Read at
# crates/aether-harness-substrate/src/settlement_config.rs:35.
# AETHER_SETTLEMENT_CAP_SECS=300

# Maximum accepted wire-frame body size in bytes, pushed into the codec before
# the RPC server binds. The compiled default is 64 MiB and the codec clamps a
# larger value to its own ceiling. Read at
# crates/aether-rpc/src/frame_size.rs:49.
# AETHER_MAX_FRAME_SIZE=67108864

# Panic-hook knobs the process reads below the config layer
# (crates/aether-chassis/src/boot.rs). Keep the crash-log directory absolute:
# the unit sets no working directory.
# AETHER_BACKTRACE=                           # :546 (unset)
# AETHER_CRASH_LOG_DISABLE=                   # :553 (unset)
# AETHER_CRASH_LOG_DIR=                       # :561 (unset)

# A TOML file whose sections supply the lowest-precedence layer under argv and
# env. Absolute, for the same reason. Read at
# crates/aether-chassis/src/boot.rs:53.
# AETHER_CONFIG_FILE=/path/to/aether-hub/hub.toml
