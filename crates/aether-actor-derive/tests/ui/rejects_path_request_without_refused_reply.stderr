error[E0277]: `Registered` cannot answer a request whose typed path failed to prove
  --> tests/ui/rejects_path_request_without_refused_reply.rs:35:86
   |
35 |     fn on_register(&mut self, _ctx: &mut WasmCtx<'_>, _register: Register) -> Registered {
